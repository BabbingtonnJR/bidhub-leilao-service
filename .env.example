# porta HTTP do serviço
PORT=3001
# MongoDB Atlas (sem esta variável o serviço sobe em memória com leilões de exemplo)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bidhub
# Azure Service Bus (sem esta variável os eventos ficam só no log)
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<regra>;SharedAccessKey=<chave>
SERVICEBUS_QUEUE=leilao-encerrado
